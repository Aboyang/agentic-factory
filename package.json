{
  "name": "wrench-bot-factory",
  "private": true,
  "workspaces": ["server", "game"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,game -c blue,green \"npm run dev -w server\" \"npm run dev -w game\"",
    "dev:mock": "MOCK_REAP=1 MOCK_AI=1 npm run dev",
    "build": "npm run build -w game",
    "start": "npm start -w server"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
