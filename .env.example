# Copy to .env and fill in. Never commit .env.
REAP_API_KEY=
REAP_BASE_URL=https://sandbox.api.reap.global
REAP_VERSION=2025-02-14
# From `npm run reap:enroll -w server` after entering the test card on Reap's page
REAP_ENROLLMENT_ID=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional fallback decision model
JEV_API_KEY=

# 1 = fake it (game devs can work offline)
MOCK_REAP=0
MOCK_AI=0
