# Copy to .env and fill in. Never commit .env.
REAP_API_KEY=
REAP_BASE_URL=https://sandbox.api.reap.global
REAP_VERSION=2025-02-14
# From `npm run reap:enroll -w server` after entering the test card on Reap's page
REAP_ENROLLMENT_ID=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional fallback decision model
JEV_API_KEY=

# 1 = fake it (game devs can work offline)
MOCK_REAP=0
MOCK_AI=0

# Onchain technician payouts (Ink Sepolia testnet USDC). Leave the key empty to simulate.
TREASURY_PRIVATE_KEY=
INK_RPC_URL=https://rpc-gel-sepolia.inkonchain.com
# 0 = never send onchain, even with a key
ONCHAIN=1
# USDC paid per $1 of technician job (0.01: a $120 job pays 1.20 USDC)
TECH_PAYOUT_SCALE=0.01
# Optional cap on real onchain payouts (count kept in server/.cache/onchain.json); unset = no cap
ONCHAIN_MAX_PAYOUTS=
# 0 = Kwal vault rail off
KWAL=1

# Judge mode (public demo): live AI + live Reap search/quotes, simulated Reap
# checkout with in-game approve/reject, idle reset to the first scenario after 10 min.
JUDGE_MODE=0
# PORT=8787
